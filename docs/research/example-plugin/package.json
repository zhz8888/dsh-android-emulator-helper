{
  "name": "dsh-example-host-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal DSH host-half plugin: one model-facing tool plus a live-editable (volatile) Config.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "manifestVersion": 1,
    "name": "example-host-tool",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "scripts": {
    "check": "node -e \"import('./lib/index.js').then(m => console.log(Object.keys(m)))\""
  }
}
