{
  "name": "dsh-android-emulator-helper",
  "version": "0.1.0",
  "icon": "./icon.svg",
  "description": "Android SDK, emulator and device management plus Kotlin/Compose build-and-run tools for DeepSeek Harness, ported from the official ZCode android-emulator plugin, with a full in-app settings page.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "android",
    "emulator",
    "adb",
    "avd"
  ],
  "license": "MIT",
  "author": {
    "name": "zhz8888"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "name": "android-emulator-helper",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --test test/*.test.js && node scripts/check-bundle.mjs && node scripts/verify-mount.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:emulator": "node scripts/smoke.mjs --with-emulator",
    "verify:mount": "node scripts/verify-mount.mjs",
    "link:dsh-deps": "node scripts/link-dsh-deps.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.8.0"
}
