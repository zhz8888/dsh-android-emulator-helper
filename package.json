{
  "name": "@zhz8888/dsh-android-emulator-helper",
  "version": "1.2.0",
  "icon": "./android-emulator.png",
  "description": "Android SDK, emulator and device management plus Kotlin/Compose build-and-run tools for DeepSeek Harness, ported from the official ZCode android-emulator plugin, with its parameter page on the plugin's own detail page in the Plugins panel.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "android",
    "emulator",
    "adb",
    "avd"
  ],
  "license": "MIT",
  "author": {
    "name": "zhz8888"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhz8888/dsh-android-emulator-helper.git"
  },
  "homepage": "https://github.com/zhz8888/dsh-android-emulator-helper#readme",
  "bugs": {
    "url": "https://github.com/zhz8888/dsh-android-emulator-helper/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "locale",
    "cordis.patch.yml",
    "android-emulator.png",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "name": "android-emulator-helper",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2",
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check": "node --test test/*.test.js && node scripts/check-bundle.mjs && node scripts/verify-mount.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:emulator": "node scripts/smoke.mjs --with-emulator",
    "verify:mount": "node scripts/verify-mount.mjs",
    "link:dsh-deps": "node scripts/link-dsh-deps.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@types/node": "22.20.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "packageManager": "pnpm@11.8.0"
}
